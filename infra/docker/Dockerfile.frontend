# Static portal served by nginx — no build step, no npm audit noise
FROM nginx:1.27-alpine
COPY frontend/ /usr/share/nginx/html/
COPY infra/config/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=4s --retries=5 \
  CMD wget -qO- http://localhost/studio >/dev/null || exit 1
