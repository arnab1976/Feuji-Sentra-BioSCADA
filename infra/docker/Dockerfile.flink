FROM flink:1.19-scala_2.12-java11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages \
    apache-flink==1.19.1 scikit-learn joblib numpy pandas
# Kafka SQL connector
ARG FLINK_KAFKA=3.2.0-1.19
RUN wget -q -O /opt/flink/lib/flink-sql-connector-kafka.jar \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/${FLINK_KAFKA}/flink-sql-connector-kafka-${FLINK_KAFKA}.jar || true
COPY services/flink-jobs/ /opt/flink-jobs/
USER flink
