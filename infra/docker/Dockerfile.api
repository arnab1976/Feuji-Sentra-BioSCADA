FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY services/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# shared source trees (parameters, knowledge base, agents)
COPY services/simulator/src/ /app/services/simulator/src/
COPY services/rag/src/       /app/services/rag/src/
COPY services/agents/src/    /app/services/agents/src/
COPY services/api/src/       /app/services/api/src/
COPY data/                   /app/data/
ENV PYTHONPATH=/app
WORKDIR /app/services/api/src
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS http://localhost:8000/api/health || exit 1
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
