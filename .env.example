# Copy to .env and adjust. All defaults work for a local run.

# --- streaming ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_BOOTSTRAP_INTERNAL=redpanda:29092
RATE_HZ=2

# --- flink ---
FLINK_WINDOW=10
BREACH_THRESHOLD=0.30
FLINK_PARALLELISM=2

# --- modelling ---
MODEL_DIR=services/ml/models
FORECAST_HORIZON=15
MLFLOW_URI=http://localhost:5000

# --- rag ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bioscada_kb
CHUNK_TOKENS=220
CHUNK_OVERLAP=40

# --- llm (local, no data egress) ---
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# --- api ---
PORT=8000
SIMULATOR_URL=http://localhost:8081
LOG_LEVEL=INFO
